{
  "opencollection": "1.0.0",
  "info": {
    "name": "Microsoft Azure AccessControlClient AccessConnector RunMetrics API",
    "version": "2020-08-01-preview"
  },
  "items": [
    {
      "info": {
        "name": "RunMetrics",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Microsoft Azure Post Metric To A Run",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "{{baseUrl}}/history/v1.0/subscriptions/:subscriptionId/resourceGroups/:resourceGroupName/providers/Microsoft.MachineLearningServices/workspaces/:workspaceName/experiments/:experimentName/runs/:runId/metrics",
            "params": [
              {
                "name": "subscriptionId",
                "value": "",
                "type": "path",
                "description": "The Azure Subscription ID."
              },
              {
                "name": "resourceGroupName",
                "value": "",
                "type": "path",
                "description": "The Name of the resource group in which the workspace is located."
              },
              {
                "name": "workspaceName",
                "value": "",
                "type": "path",
                "description": "The name of the workspace."
              },
              {
                "name": "experimentName",
                "value": "",
                "type": "path",
                "description": "The experiment name."
              },
              {
                "name": "runId",
                "value": "",
                "type": "path",
                "description": "The identifier for a run."
              }
            ]
          },
          "docs": "Post a Metric to a specific Run Id."
        },
        {
          "info": {
            "name": "Microsoft Azure Post Metrics To A Run",
            "type": "http"
