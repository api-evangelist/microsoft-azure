        },
        {
          "info": {
            "name": "Microsoft Azure Delete Text Blocklist By Blocklistname",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "{{baseUrl}}/text/blocklists/:blocklistName",
            "params": [
              {
                "name": "api-version",
                "value": "",
                "type": "query",
                "description": "The API version to use for this operation."
              },
              {
                "name": "blocklistName",
                "value": "",
                "type": "path",
                "description": "Text blocklist name."
              }
            ]
