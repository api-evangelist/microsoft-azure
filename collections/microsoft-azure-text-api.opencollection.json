          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/text/blocklists/:blocklistName/blocklistItems/:blocklistItemId",
            "params": [
              {
                "name": "api-version",
                "value": "",
                "type": "query",
                "description": "The API version to use for this operation."
              },
              {
                "name": "blocklistName",
                "value": "",
                "type": "path",
                "description": "Text blocklist name."
              },
              {
                "name": "blocklistItemId",
                "value": "",
                "type": "path",
                "description": "The service will generate a BlocklistItemId, which will be a UUID."
              }
            ]
          },
          "docs": "Get blocklistItem by blocklistName and blocklistItemId from a text blocklist."
        }
      ]
    }
