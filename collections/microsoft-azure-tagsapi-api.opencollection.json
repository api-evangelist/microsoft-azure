            "name": "Microsoft Azure Get Information About A Specific Tag",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/projects/:projectId/tags/:tagId",
            "params": [
              {
                "name": "projectId",
                "value": "",
                "type": "path",
                "description": "The project this tag belongs to."
              },
              {
                "name": "tagId",
                "value": "",
                "type": "path",
                "description": "The tag id."
              },
              {
                "name": "iterationId",
                "value": "",
                "type": "query",
                "description": "The iteration to retrieve this tag from. Optional, defaults to current training set."
              }
            ]
          },
          "docs": "Needs a more full description created."
