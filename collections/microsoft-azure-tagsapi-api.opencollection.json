      "items": [
        {
          "info": {
            "name": "Microsoft Azure Get The Tags For A Given Project And Iteration",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/projects/:projectId/tags",
            "params": [
              {
                "name": "projectId",
                "value": "",
                "type": "path",
                "description": "The project id."
              },
              {
                "name": "iterationId",
                "value": "",
                "type": "query",
                "description": "The iteration id. Defaults to workspace."
              }
            ]
          },
          "docs": "Needs a more full description created."
        },
        {
          "info": {
            "name": "Microsoft Azure Create A Tag For The Project",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "{{baseUrl}}/projects/:projectId/tags",
            "params": [
              {
                "name": "projectId",
                "value": "",
                "type": "path",
                "description": "The project id."
              },
              {
                "name": "name",
                "value": "",
                "type": "query",
                "description": "The tag name."
              },
              {
                "name": "description",
                "value": "",
                "type": "query",
                "description": "Optional description for the tag."
              },
              {
                "name": "type",
                "value": "",
                "type": "query",
                "description": "Optional type for the tag."
              }
            ]
          },
          "docs": "Needs a more full description created."
        },
        {
