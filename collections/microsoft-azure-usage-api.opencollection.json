      "items": [
        {
          "info": {
            "name": "Microsoft Azure Get Subscriptions Subscriptionid Providers Microsoft Storage Usages",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/subscriptions/:subscriptionId/providers/Microsoft.Storage/usages",
            "params": [
              {
                "name": "api-version",
                "value": "",
                "type": "query",
                "description": "Client Api Version."
              },
              {
                "name": "subscriptionId",
                "value": "",
                "type": "path",
                "description": "Gets subscription credentials which uniquely identify the Microsoft Azure subscription. The subscription ID forms part of the URI for every service call."
              }
            ]
          },
          "docs": "Gets the current usage count and the limit for the resources under the subscription."
        },
        {
          "info": {
            "name": "Microsoft Azure Returns Usage Records For Specified Subscription And Resource Groups",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/subscriptions/:subscriptionId/resourceGroups/:resourceGroupName/providers/Microsoft.Web.Admin/environments/:environmentName/usage",
            "params": [
              {
                "name": "resourceGroupName",
                "value": "",
                "type": "path",
                "description": "Name of resource group"
              },
              {
                "name": "environmentName",
                "value": "",
                "type": "path",
                "description": "Environment name"
              },
              {
                "name": "lastId",
                "value": "",
                "type": "query",
                "description": "Last marker that was returned from the batch"
              },
              {
                "name": "batchSize",
                "value": "",
                "type": "query",
                "description": "size of the batch to be returned."
              },
              {
                "name": "subscriptionId",
                "value": "",
                "type": "path",
                "description": "Subscription Id"
              },
              {
                "name": "api-version",
                "value": "",
                "type": "query",
                "description": "API Version"
              }
            ]
          },
          "docs": "Needs a more full description created."
        }
      ]
    }
