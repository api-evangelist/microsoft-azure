{
  "opencollection": "1.0.0",
  "info": {
    "name": "Microsoft Azure AccessControlClient AccessConnector Volume Groups API",
    "version": "2020-08-01-preview"
  },
  "items": [
    {
      "info": {
        "name": "Volume Groups",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Microsoft Azure Describe All Volume Groups",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/subscriptions/:subscriptionId/resourceGroups/:resourceGroupName/providers/Microsoft.NetApp/netAppAccounts/:accountName/volumeGroups",
            "params": [
              {
                "name": "accountName",
                "value": "",
                "type": "path",
                "description": "The name of the NetApp account"
              }
            ]
          },
          "docs": "List all volume groups for given account"
        },
        {
          "info": {
            "name": "Microsoft Azure Describe A Volume Group",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/subscriptions/:subscriptionId/resourceGroups/:resourceGroupName/providers/Microsoft.NetApp/netAppAccounts/:accountName/volumeGroups/:volumeGroupName",
            "params": [
              {
                "name": "accountName",
                "value": "",
                "type": "path",
                "description": "The name of the NetApp account"
              },
              {
                "name": "volumeGroupName",
                "value": "",
                "type": "path",
                "description": "The name of the volumeGroup"
              }
            ]
          },
          "docs": "Get details of the specified volume group"
        },
        {
          "info": {
            "name": "Microsoft Azure Create The Specified Volume Group And Volumes Creating Volume Group Will Create All The Volumes Specified In Request Body Implicitly Once Volumes Are Created Using Volume Group, Those Will Be Treated As Regular Volumes Thereafter",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "{{baseUrl}}/subscriptions/:subscriptionId/resourceGroups/:resourceGroupName/providers/Microsoft.NetApp/netAppAccounts/:accountName/volumeGroups/:volumeGroupName",
            "params": [
              {
                "name": "accountName",
                "value": "",
                "type": "path",
                "description": "The name of the NetApp account"
              },
              {
                "name": "volumeGroupName",
                "value": "",
                "type": "path",
                "description": "The name of the volumeGroup"
              }
            ]
          },
          "docs": "Create a volume group along with specified volumes"
        },
        {
          "info": {
            "name": "Microsoft Azure Delete A Volume Group",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "{{baseUrl}}/subscriptions/:subscriptionId/resourceGroups/:resourceGroupName/providers/Microsoft.NetApp/netAppAccounts/:accountName/volumeGroups/:volumeGroupName",
            "params": [
              {
                "name": "accountName",
                "value": "",
                "type": "path",
                "description": "The name of the NetApp account"
              },
              {
                "name": "volumeGroupName",
                "value": "",
                "type": "path",
                "description": "The name of the volumeGroup"
              }
            ]
          },
          "docs": "Delete the specified volume group only if there are no volumes under volume group."
        }
      ]
    }
  ],
  "bundled": true
}