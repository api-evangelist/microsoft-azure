  "items": [
    {
      "info": {
        "name": "Package",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Microsoft Azure Package  Gets Published Luis Application Package In Binary Stream Gzip Format",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/package/:appId/slot/:slotName/gzip",
            "params": [
              {
                "name": "appId",
                "value": "",
                "type": "path",
                "description": "The application ID."
              },
              {
                "name": "slotName",
                "value": "",
                "type": "path",
                "description": "The publishing slot name."
              }
            ]
          },
          "docs": "Packages a published LUIS application as a GZip file to be used in the LUIS container."
        },
        {
          "info": {
            "name": "Microsoft Azure Package  Gets Trained Luis Application Package In Binary Stream Gzip Format",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/package/:appId/versions/:versionId/gzip",
            "params": [
              {
                "name": "appId",
                "value": "",
                "type": "path",
                "description": "The application ID."
              },
              {
                "name": "versionId",
                "value": "",
                "type": "path",
                "description": "The version ID."
              }
            ]
          },
          "docs": "Packages trained LUIS application as GZip file to be used in the LUIS container."
        }
      ]
    }
  ],
  "bundled": true
