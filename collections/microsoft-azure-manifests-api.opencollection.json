  },
  "items": [
    {
      "info": {
        "name": "Manifests",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Microsoft Azure List Manifests",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/acr/v1/:name/_manifests",
            "params": [
              {
                "name": "name",
                "value": "",
                "type": "path",
                "description": "Name of the image (including the namespace)."
              },
              {
                "name": "last",
                "value": "example_value",
                "type": "query",
                "description": "Query parameter for the last item in previous call."
              },
              {
                "name": "n",
                "value": "10",
                "type": "query",
                "description": "Number of manifests to return."
              },
              {
                "name": "orderby",
                "value": "timedesc",
                "type": "query",
                "description": "Orderby query parameter."
              }
            ]
          },
          "docs": "List manifests of a repository."
        },
        {
          "info": {
            "name": "Microsoft Azure Get a Manifest",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/v2/:name/manifests/:reference",
            "headers": [
              {
                "name": "Accept",
                "value": "example_value"
              }
            ],
            "params": [
              {
                "name": "name",
                "value": "",
                "type": "path",
                "description": "Name of the image (including the namespace)."
              },
              {
                "name": "reference",
                "value": "example_value",
                "type": "path",
                "description": "A tag or a digest, pointing to a specific image."
              }
            ]
          },
          "docs": "Get the manifest identified by name and reference."
        },
        {
          "info": {
            "name": "Microsoft Azure Put a Manifest",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "{{baseUrl}}/v2/:name/manifests/:reference",
            "params": [
              {
                "name": "name",
                "value": "",
                "type": "path",
                "description": "Name of the image (including the namespace)."
              },
              {
                "name": "reference",
                "value": "example_value",
                "type": "path",
                "description": "A tag or a digest, pointing to a specific image."
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Put the manifest identified by name and reference."
        },
        {
          "info": {
            "name": "Microsoft Azure Delete a Manifest",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "{{baseUrl}}/v2/:name/manifests/:reference",
            "params": [
              {
                "name": "name",
                "value": "",
                "type": "path",
                "description": "Name of the image (including the namespace)."
              },
              {
                "name": "reference",
                "value": "example_value",
                "type": "path",
                "description": "Digest of a manifest."
              }
            ]
          },
          "docs": "Delete the manifest identified by name and reference."
        }
      ]
    }
  ],
  "bundled": true
