{
  "opencollection": "1.0.0",
  "info": {
    "name": "Microsoft Azure AccessControlClient AccessConnector Backup Policy API",
    "version": "2020-08-01-preview"
  },
  "items": [
    {
      "info": {
        "name": "Backup Policy",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Microsoft Azure List Backup Policies",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/subscriptions/:subscriptionId/resourceGroups/:resourceGroupName/providers/Microsoft.NetApp/netAppAccounts/:accountName/backupPolicies",
            "params": [
              {
                "name": "accountName",
                "value": "",
                "type": "path",
                "description": "The name of the NetApp account"
              }
            ]
          },
          "docs": "List backup policies for Netapp Account"
        },
        {
          "info": {
            "name": "Microsoft Azure Get A Backup Policy",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/subscriptions/:subscriptionId/resourceGroups/:resourceGroupName/providers/Microsoft.NetApp/netAppAccounts/:accountName/backupPolicies/:backupPolicyName",
            "params": [
              {
                "name": "accountName",
                "value": "",
                "type": "path",
                "description": "The name of the NetApp account"
              },
              {
                "name": "backupPolicyName",
                "value": "",
                "type": "path",
                "description": "Backup policy Name which uniquely identify backup policy."
              }
            ]
          },
          "docs": "Get a particular backup Policy"
        },
        {
          "info": {
            "name": "Microsoft Azure Create A Backup Policy",
