          "http": {
            "method": "PATCH",
            "url": "{{baseUrl}}/subscriptions/:subscriptionId/resourceGroups/:resourceGroupName/providers/Microsoft.NetApp/netAppAccounts/:accountName/backupPolicies/:backupPolicyName",
