            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/subscriptions/:subscriptionId/resourceGroups/:resourceGroupName/providers/Nginx.NginxPlus/nginxDeployments/:deploymentName/certificates/:certificateName",
            "params": [
              {
                "name": "deploymentName",
                "value": "",
                "type": "path",
                "description": "The name of targeted Nginx deployment"
              },
              {
                "name": "certificateName",
                "value": "",
                "type": "path",
                "description": "The name of certificate"
              }
            ]
          },
