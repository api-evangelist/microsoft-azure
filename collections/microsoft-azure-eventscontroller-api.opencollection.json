            "name": "Microsoft Azure Gets An Event In The Migrate Project",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/subscriptions/:subscriptionId/resourceGroups/:resourceGroupName/providers/Microsoft.Migrate/migrateProjects/:migrateProjectName/migrateEvents/:eventName",
            "params": [
              {
                "name": "migrateProjectName",
                "value": "",
                "type": "path",
                "description": "Name of the Azure Migrate project."
              },
              {
                "name": "eventName",
                "value": "",
                "type": "path",
                "description": "Unique name of an event within a migrate project."
              }
            ]
          },
          "docs": "Needs a more full description created."
        },
        {
