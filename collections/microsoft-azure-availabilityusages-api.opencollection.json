              },
              {
                "name": "regionId",
                "value": "",
                "type": "path",
                "description": "The region Id (westus, eastus)"
              },
              {
                "name": "$filter",
                "value": "",
                "type": "query",
                "description": "The filter to apply on the list operation. only name.value is allowed here as a filter e.g. $filter=name.value eq 'xxxx'"
              },
              {
                "name": "api-version",
                "value": "",
                "type": "query",
                "description": "Client API version."
              }
            ]
