              {
                "name": "api-version",
                "value": "",
                "type": "query",
                "description": "Client API version."
              }
            ]
          },
          "docs": "Returns list of available resources in region"
        },
        {
          "info": {
            "name": "Microsoft Azure Implements Usages List Method",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/subscriptions/:subscriptionId/providers/Microsoft.VMwareCloudSimple/locations/:regionId/usages",
            "params": [
