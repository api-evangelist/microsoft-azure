          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/subscriptions/:subscriptionId/providers/Microsoft.VMwareCloudSimple/locations/:regionId/availabilities",
            "params": [
              {
                "name": "subscriptionId",
                "value": "",
                "type": "path",
                "description": "The subscription ID."
              },
              {
                "name": "regionId",
                "value": "",
                "type": "path",
                "description": "The region Id (westus, eastus)"
              },
              {
                "name": "skuId",
                "value": "",
                "type": "query",
                "description": "sku id, if no sku is passed availability for all skus will be returned"
