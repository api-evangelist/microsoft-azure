            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/acr/v1/:name/_tags",
            "params": [
              {
                "name": "name",
                "value": "",
                "type": "path",
                "description": "Name of the image (including the namespace)."
              },
              {
                "name": "last",
                "value": "example_value",
                "type": "query",
                "description": "Query parameter for the last item in previous call."
              },
              {
                "name": "n",
                "value": "10",
                "type": "query",
                "description": "Number of tags to return."
              },
              {
                "name": "orderby",
                "value": "timedesc",
                "type": "query",
                "description": "Orderby query parameter."
              },
              {
                "name": "digest",
                "value": "example_value",
                "type": "query",
                "description": "Filter by digest."
              }
            ]
          },
          "docs": "List tags of a repository."
        },
        {
          "info": {
            "name": "Microsoft Azure Get Tag Attributes",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/acr/v1/:name/_tags/:reference",
            "params": [
              {
                "name": "name",
                "value": "",
                "type": "path",
                "description": "Name of the image (including the namespace)."
              },
              {
                "name": "reference",
                "value": "example_value",
                "type": "path",
                "description": "Tag name."
              }
            ]
          },
          "docs": "Get tag attributes by tag."
        },
        {
          "info": {
