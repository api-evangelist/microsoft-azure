        {
          "info": {
            "name": "Microsoft Azure List Secrets",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/secrets",
            "params": [
              {
                "name": "api-version",
                "value": "",
                "type": "query",
                "description": "Client API version."
              },
              {
                "name": "maxresults",
                "value": "10",
                "type": "query",
                "description": "Maximum number of results to return in a page (1-25)."
              }
            ]
          },
          "docs": "List secrets in the specified vault. The Get Secrets operation applies to the entire vault. However, only the base secret identifier and its attributes are provided in the response."
        },
        {
          "info": {
            "name": "Microsoft Azure Set a Secret",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "{{baseUrl}}/secrets/:secret-name",
            "params": [
              {
                "name": "secret-name",
                "value": "example_value",
                "type": "path",
                "description": "The name of the secret."
              },
              {
                "name": "api-version",
                "value": "",
                "type": "query",
                "description": "Client API version."
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Sets a secret in the specified vault. The set operation adds a secret to the Azure Key Vault. If the named secret already exists, Azure Key Vault creates a new version of that secret."
        },
        {
          "info": {
            "name": "Microsoft Azure Delete a Secret",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "{{baseUrl}}/secrets/:secret-name",
            "params": [
              {
                "name": "secret-name",
                "value": "example_value",
                "type": "path",
                "description": "The name of the secret to delete."
              },
              {
                "name": "api-version",
                "value": "",
                "type": "query",
                "description": "Client API version."
              }
            ]
          },
          "docs": "Deletes a secret from a specified key vault."
        },
        {
          "info": {
            "name": "Microsoft Azure Get a Secret",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/secrets/:secret-name/:secret-version",
            "params": [
              {
                "name": "secret-name",
                "value": "example_value",
                "type": "path",
                "description": "The name of the secret."
              },
              {
                "name": "secret-version",
                "value": "example_value",
                "type": "path",
                "description": "The version of the secret. Use empty string for the latest version."
              },
              {
                "name": "api-version",
                "value": "",
                "type": "query",
                "description": "Client API version."
              }
            ]
          },
          "docs": "Get a specified secret from a given key vault. The GET operation is applicable to any secret stored in Azure Key Vault."
        },
