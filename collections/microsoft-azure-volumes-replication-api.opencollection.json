              {
                "name": "accountName",
                "value": "",
                "type": "path",
                "description": "The name of the NetApp account"
              },
              {
                "name": "poolName",
                "value": "",
                "type": "path",
                "description": "The name of the capacity pool"
              },
              {
                "name": "volumeName",
                "value": "",
                "type": "path",
                "description": "The name of the volume"
              }
            ]
          },
          "docs": "Resync the connection on the destination volume. If the operation is ran on the source volume it will reverse-resync the connection and sync from destination to source."
        },
        {
          "info": {
            "name": "Microsoft Azure Delete Volume Replication",
            "type": "http"
