          "http": {
            "method": "POST",
            "url": "{{baseUrl}}/subscriptions/:subscriptionId/resourceGroups/:resourceGroupName/providers/Microsoft.NetApp/netAppAccounts/:accountName/capacityPools/:poolName/volumes/:volumeName/reinitializeReplication",
            "params": [
              {
