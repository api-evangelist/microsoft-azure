                "name": "poolName",
                "value": "",
                "type": "path",
                "description": "The name of the capacity pool"
              },
              {
                "name": "volumeName",
                "value": "",
                "type": "path",
                "description": "The name of the volume"
              }
            ]
          },
          "docs": "Get the status of the replication"
