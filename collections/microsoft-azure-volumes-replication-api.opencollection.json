              {
                "name": "poolName",
                "value": "",
                "type": "path",
                "description": "The name of the capacity pool"
              },
              {
                "name": "volumeName",
                "value": "",
                "type": "path",
                "description": "The name of the volume"
              }
            ]
          },
          "docs": "List all replications for a specified volume"
        },
        {
          "info": {
            "name": "Microsoft Azure Resync Volume Replication",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "{{baseUrl}}/subscriptions/:subscriptionId/resourceGroups/:resourceGroupName/providers/Microsoft.NetApp/netAppAccounts/:accountName/capacityPools/:poolName/volumes/:volumeName/resyncReplication",
