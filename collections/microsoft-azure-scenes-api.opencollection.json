{
  "opencollection": "1.0.0",
  "info": {
    "name": "Microsoft Azure AccessControlClient AccessConnector Scenes API",
    "version": "2020-08-01-preview"
  },
  "items": [
    {
      "info": {
        "name": "Scenes",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Microsoft Azure Get Scenes",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/scenes",
            "params": [
              {
                "name": "provider",
                "value": "",
                "type": "query",
                "description": "Provider name of scene data."
              },
              {
                "name": "partyId",
                "value": "",
                "type": "query",
                "description": "PartyId."
              },
              {
                "name": "boundaryId",
                "value": "",
                "type": "query",
                "description": "BoundaryId."
              },
              {
                "name": "source",
                "value": "",
                "type": "query",
                "description": "Source name of scene data, Available Values: Sentinel_2_L2A, Sentinel_2_L1C."
              },
              {
                "name": "startDateTime",
                "value": "",
                "type": "query",
                "description": "Scene start UTC datetime (inclusive), sample format: yyyy-MM-ddThh:mm:ssZ."
              },
              {
                "name": "endDateTime",
                "value": "",
                "type": "query",
                "description": "Scene end UTC datetime (inclusive), sample format: yyyy-MM-dThh:mm:ssZ."
              },
              {
                "name": "maxCloudCoveragePercentage",
                "value": "",
                "type": "query",
                "description": "Filter scenes with cloud coverage percentage less than max value. Range [0 to 100.0]."
              },
              {
                "name": "maxDarkPixelCoveragePercentage",
                "value": "",
                "type": "query",
                "description": "Filter scenes with dark pixel coverage percentage less than max value. Range [0 to 100.0]."
              },
              {
                "name": "imageNames",
                "value": "",
                "type": "query",
                "description": "List of image names to be filtered."
              },
              {
                "name": "imageResolutions",
                "value": "",
                "type": "query",
                "description": "List of image resolutions in meters to be filtered."
              },
              {
                "name": "imageFormats",
                "value": "",
                "type": "query",
                "description": "List of image formats to be filtered."
              },
              {
                "name": "maxPageSize",
                "value": "",
                "type": "query",
                "description": "Maximum number of items needed (inclusive).\r\nMinimum = 10, Maximum = 1000, Default value = 50."
              },
              {
                "name": "skipToken",
                "value": "",
                "type": "query",
                "description": "Skip token for getting next set of results."
              },
              {
                "name": "api-version",
                "value": "",
                "type": "query",
                "description": "The requested API version"
              }
            ]
          },
          "docs": "Returns a paginated list of scene resources."
        },
        {
          "info": {
            "name": "Microsoft Azure Get Scenes Downloadfiles",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/scenes/downloadFiles",
            "params": [
              {
                "name": "filePath",
                "value": "",
                "type": "query",
                "description": "cloud storage path of scene file."
              },
              {
                "name": "api-version",
                "value": "",
                "type": "query",
                "description": "The requested API version"
              }
            ]
          },
          "docs": "Downloads and returns file Stream as response for the given input filePath."
        },
        {
          "info": {
            "name": "Microsoft Azure Get Scenes Satellite Ingest Data Jobid",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/scenes/satellite/ingest-data/:jobId",
            "params": [
              {
                "name": "jobId",
                "value": "",
                "type": "path",
                "description": "Id of the job."
              },
              {
                "name": "api-version",
                "value": "",
                "type": "query",
                "description": "The requested API version"
              }
            ]
          },
          "docs": "Get a satellite data ingestion job."
        },
        {
          "info": {
            "name": "Microsoft Azure Put Scenes Satellite Ingest Data Jobid",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "{{baseUrl}}/scenes/satellite/ingest-data/:jobId",
            "params": [
              {
                "name": "jobId",
                "value": "",
                "type": "path",
                "description": "JobId provided by user."
              },
              {
                "name": "api-version",
                "value": "",
                "type": "query",
                "description": "The requested API version"
              }
            ]
          },
          "docs": "Create a satellite data ingestion job."
        },
        {
          "info": {
            "name": "Microsoft Azure Post Scenes Stac Collections Collectionid:search",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "{{baseUrl}}/scenes/stac-collections/:collectionId:search",
            "params": [
              {
                "name": "collectionId",
                "value": "",
                "type": "path",
                "description": "Collection Id to be searched."
              },
              {
                "name": "maxpagesize",
                "value": "",
                "type": "query",
                "description": "Maximum number of features needed (inclusive). Minimum = 1, Maximum = 100, Default value = 10."
              },
              {
                "name": "skip",
                "value": "",
                "type": "query",
                "description": "Skip token for getting next set of results."
              },
              {
                "name": "api-version",
                "value": "",
                "type": "query",
                "description": "The requested API version"
              }
            ]
          },
          "docs": "Search for STAC features by collection id, bbox, intersecting geometry, start and end datetime."
        },
        {
          "info": {
            "name": "Microsoft Azure Get Scenes Stac Collections Collectionid Features Featureid",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/scenes/stac-collections/:collectionId/features/:featureId",
            "params": [
              {
                "name": "collectionId",
                "value": "",
                "type": "path",
                "description": "Collection Id to be fetched."
              },
              {
                "name": "featureId",
                "value": "",
                "type": "path",
                "description": "Feature Id to be fetched."
              },
              {
                "name": "api-version",
                "value": "",
                "type": "query",
                "description": "The requested API version"
              }
            ]
          },
          "docs": "Get a feature(SpatioTemporal Asset Catalog (STAC) Item) for given collection and feature id."
        }
      ]
    }
  ],
  "bundled": true
}